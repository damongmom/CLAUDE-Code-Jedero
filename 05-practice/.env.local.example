# 이 파일을 복사해 .env.local을 만들고 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# 자세한 설정 방법: docs/GITHUB_OAUTH.md

# MongoDB
# 로컬 예: mongodb://127.0.0.1:27017/todo-goal-app
# Atlas 예: mongodb+srv://<user>:<password>@<cluster>/todo-goal-app
MONGODB_URI=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL은 ${APP_BASE_URL}/auth/github/callback 이어야 합니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 앱 주소. 브라우저에서도 이 주소로 접속하세요(localhost와 127.0.0.1은 다른 주소로 취급됩니다).
APP_BASE_URL=http://localhost:3000

# (선택) Node가 Atlas 주소의 DNS 조회에 실패할 때 사용할 DNS 서버, 쉼표로 구분
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
